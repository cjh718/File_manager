<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bar_share"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="56dp"
        android:text="@string/share"
        android:textSize="12sp"
        app:icon="@drawable/ic_share"
        app:iconGravity="textTop"
        app:iconPadding="2dp"
        app:iconSize="22dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bar_move"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="56dp"
        android:text="@string/move"
        android:textSize="12sp"
        app:icon="@drawable/ic_move"
        app:iconGravity="textTop"
        app:iconPadding="2dp"
        app:iconSize="22dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bar_delete"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="56dp"
        android:text="@string/delete"
        android:textColor="@color/delete_action"
        android:textSize="12sp"
        app:icon="@drawable/ic_delete"
        app:iconGravity="textTop"
        app:iconPadding="2dp"
        app:iconSize="22dp"
        app:iconTint="@color/delete_action"
        app:rippleColor="@color/delete_action" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bar_more"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="56dp"
        android:text="@string/more"
        android:textSize="12sp"
        app:icon="@drawable/ic_more"
        app:iconGravity="textTop"
        app:iconPadding="2dp"
        app:iconSize="22dp" />

</LinearLayout>