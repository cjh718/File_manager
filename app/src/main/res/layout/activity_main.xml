<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/permission_screen"
        layout="@layout/view_permission" />

    <LinearLayout
        android:id="@+id/app_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:menu="@menu/menu_main"
            app:subtitleTextColor="@color/muted_text"
            app:titleTextAppearance="@style/TextAppearance.Folio.Toolbar"
            app:titleTextColor="@color/text" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/home_screen"
                layout="@layout/view_home" />

            <include
                android:id="@+id/browser_screen"
                layout="@layout/view_browser"
                android:visibility="gone" />

        </FrameLayout>
    </LinearLayout>

</FrameLayout>
